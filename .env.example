# VİADENT yerel geliştirme ortamı — GERÇEK DEĞER YAZMAYIN, bu dosya örnektir.
# Kopyalayın: cp .env.example .env

# Uygulamanın (API/worker) bağlandığı kısıtlı rol: superuser/owner/BYPASSRLS DEĞİL.
DATABASE_URL=postgres://viadent_app:CHANGE_ME_APP@localhost:5432/viadent
# Arka plan işçisinin kısıtlı rolü (NOBYPASSRLS; yalnız outbox ve tenant listesi için ek politika).
WORKER_DATABASE_URL=postgres://viadent_worker:CHANGE_ME_WORKER@localhost:5432/viadent
VIADENT_WORKER_DB_PASSWORD=CHANGE_ME_WORKER
# Migration ve tablo sahibi rol (yalnız migration/seed komutlarında kullanılır).
MIGRATION_DATABASE_URL=postgres://viadent_owner:CHANGE_ME_OWNER@localhost:5432/viadent
# Rolleri oluşturmak için yönetici bağlantısı (yalnız db:roles adımında).
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME_ADMIN@localhost:5432/postgres
VIADENT_APP_DB_PASSWORD=CHANGE_ME_APP
VIADENT_OWNER_DB_PASSWORD=CHANGE_ME_OWNER

# Sentetik demo kullanıcılarının parolası. Boş bırakılırsa seed rastgele üretip
# .demo-credentials dosyasına (git'e girmez) yazar.
VIADENT_DEMO_PASSWORD=

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
SESSION_TTL_HOURS=12
# Boşta kalma süresi (dk): bu kadar süre istek gelmeyen oturum düşer (açık bırakılan klinik ekranı). 0 = kapalı.
SESSION_IDLE_MINUTES=90
# Hesap başına art arda hatalı girişte kademeli yanıt gecikmesi üst sınırı (ms); 0 = kapalı (ADR-065)
LOGIN_BACKOFF_MAX_MS=2000

# Özel dosya deposu (web kökü dışında; sunucu süreci okur). Üretimde şifreli disk veya S3 uyumlu özel bucket.
STORAGE_DIR=./.storage
# ClamAV (clamd) — boşsa yalnız temel tarayıcı çalışır (tam antivirüs değildir, ADR-034)
CLAMD_HOST=
CLAMD_PORT=3310

# Sağlayıcı sırlarını (webhook imza anahtarı vb.) şifreleyen 32 baytlık uygulama anahtarı (base64). Üretimde secret manager'dan gelir.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VIADENT_SECRET_KEY=
# Anahtar döndürme geçiş dönemi: eski anahtar(lar), virgülle; yalnız çözmek için (pnpm db:rotate-keys, ADR-052).
VIADENT_SECRET_KEYS_OLD=
# Canlı (live) sağlayıcıya dış gönderim kapısı. Sözleşme + test kanıtı olmadan true yapılmaz (ADR-037).
VIADENT_EXTERNAL_SEND_ENABLED=false

# Yedek rolü (BYPASSRLS, yalnız okuma) — yalnız yedek/geri yükleme betiklerinde. Boşsa rol oluşturulmaz.
VIADENT_BACKUP_DB_PASSWORD=
BACKUP_DATABASE_URL=postgres://viadent_backup:CHANGE_ME_BACKUP@localhost:5432/viadent
# Yedek dosyalarını şifreleyen parola (AES-256-GCM, scrypt anahtar türetme; en az 16 karakter). Üretimde secret manager'dan; yedekle aynı yerde SAKLAMAYIN.
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_DIR=./.backups
# Platform tabanı: bu rollerde iki adımlı doğrulama her klinikte zorunlu; boş = klinik kendi politikasını belirler (Yönetim → Güvenlik).
VIADENT_REQUIRE_MFA_ROLES=
# En yeni kaç yedek tutulur.
BACKUP_KEEP=14

# Ters vekil güveni: yerelde loopback; tek ters vekil arkasında "1" (gerçek istemci IP'si giriş sınırlayıcısı ve denetim için).
TRUST_PROXY=loopback
# /api/v1/metrics belirteci (Prometheus). Boş = uç kapalı.
METRICS_TOKEN=
# İçe aktarma satır verisinin saklama süresi (gün; danışmanla kesinleştirilecek varsayılan, ADR-054).
IMPORT_ROW_RETENTION_DAYS=30
# Sağlık ucunda görünen sürüm (imaj etiketi).
VIADENT_VERSION=dev
